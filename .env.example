# Copy to .env and fill in secrets locally. Never commit .env.
JROCAI_DB_PATH=jroc_core.db
JROCAI_LICENSE_SECRET=
JROCAI_WEBHOOK_SECRET=
JROCAI_HUB_API_TOKEN=

# Optional sibling-repository discovery. Use semicolon-separated paths on Windows.
JROC_REPO_PATHS=
JROC_REPO_ROOTS=

# Optional, explicit allowlist of variable names to pass to configured sibling workflows.
# Example: OPENROUTER_API_KEY,GOOGLE_API_KEY
JROC_HUB_FORWARD_ENV=

# Optional model credentials used by jrocai workflows.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
